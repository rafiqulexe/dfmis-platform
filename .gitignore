# OS / editor cruft
.DS_Store
Thumbs.db

# Environment / secrets — never commit real credentials
.env
.env.local

# Claude Code session-local state and global skill bundle (tooling, not project content)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/skills/

# Composer dependencies. composer.lock IS committed (this is an application,
# not a library — every environment must resolve identical versions), but the
# installed tree is rebuilt from it and never stored.
vendor/
node_modules/

# Tooling caches and analysis artifacts
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
/tools/*.phar

# Local scratch
*.log
