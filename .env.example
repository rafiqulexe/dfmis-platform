# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials or API keys.
#
# NOTHING in this file is a real secret. It is a template of NAMES only.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "local" / "development" / "dev"  -> errors displayed in the browser
# anything else (including unset)  -> errors logged only, never displayed
# A missing or misspelled value therefore fails SAFE.
APP_ENV=production

# ---------------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------------
# Set APP_URL in production. It removes all guessing and closes the
# Host-header injection path entirely — the app never reflects a client-
# supplied Host into a redirect or an absolute asset URL.
# APP_URL=https://farm.example.com/

# If APP_URL is not set, only these hosts may be reflected from the Host
# header. Comma-separated. Anything else falls back to the first entry.
APP_ALLOWED_HOSTS=localhost,localhost:8000,127.0.0.1

# Set to 1 ONLY when the app genuinely sits behind a trusted reverse proxy.
# When 0, X-Forwarded-For is ignored so a client cannot forge its own IP in
# the audit log and defeat login throttling.
APP_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dfms
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# International defaults (Phase 2A)
# ---------------------------------------------------------------------------
# Bottom of the farm -> organization -> platform hierarchy. An INVALID value
# here falls back to the built-in constant rather than propagating.
# APP_DEFAULT_TIMEZONE=UTC
# APP_DEFAULT_LOCALE=en
# APP_DEFAULT_CURRENCY=USD
# APP_DEFAULT_MEASUREMENT=metric

# ---------------------------------------------------------------------------
# Testing (Phase 2B)
# ---------------------------------------------------------------------------
# PHPUnit runs against an ISOLATED database, never the development one.
# Create it with: php tools/test-db.php --create
# The name must end in _test — tools/test-db.php refuses anything else, and
# tests/bootstrap.php refuses to run destructive tests against a database that
# has not positively identified itself as a test database.
DFMS_TEST_DB_NAME=dfms_test

# Base URL the HTTP test suites target.
# DFMS_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI provider (Phase 5D — the AI Veterinarian Assistant)
# ---------------------------------------------------------------------------
# THE ONLY PLACE A PROVIDER CREDENTIAL EVER LIVES. It is read from the
# environment at boot, never stored in the database, never sent to the browser,
# never written to the audit log, and never included in an API response or an
# exception message.
#
# Leave BLANK and the assistant reports itself unconfigured and refuses to
# answer. It never fabricates a reply — an unavailable model must not look like
# a confident answer.
#
# ---------------------------------------------------------------------------
# WHICH PROVIDER
# ---------------------------------------------------------------------------
# One of: anthropic | gemini      (default: anthropic)
#
# EXACTLY ONE PROVIDER IS ACTIVE. The other is never constructed and its key is
# never read. There is NO fallback chain: if the configured provider has no
# key, the assistant degrades to its normal "not configured" state rather than
# quietly answering from the other vendor — an operator must never believe they
# are talking to a model they did not choose.
# AI_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Provider credentials — fill in only the one AI_PROVIDER names
# ---------------------------------------------------------------------------
# Both are read from the environment only, never stored in the database, never
# sent to the browser, never written to the audit log, and never included in an
# API response or an exception message.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Optional. When unset, the model follows the provider:
#   anthropic -> claude-sonnet-5
#   gemini    -> gemini-2.5-flash
# Set it to pin any model the configured key can reach. The value is validated
# against a strict identifier pattern; anything malformed is discarded with a
# log line and the provider default is used.
# AI_MODEL=
