# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials or API keys.
#
# NOTHING in this file is a real secret. It is a template of NAMES only.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "local" / "development" / "dev"  -> errors displayed in the browser
# anything else (including unset)  -> errors logged only, never displayed
# A missing or misspelled value therefore fails SAFE.
APP_ENV=production

# ---------------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------------
# Set APP_URL in production. It removes all guessing and closes the
# Host-header injection path entirely — the app never reflects a client-
# supplied Host into a redirect or an absolute asset URL.
# APP_URL=https://farm.example.com/

# If APP_URL is not set, only these hosts may be reflected from the Host
# header. Comma-separated. Anything else falls back to the first entry.
APP_ALLOWED_HOSTS=localhost,localhost:8000,127.0.0.1

# Set to 1 ONLY when the app genuinely sits behind a trusted reverse proxy.
# When 0, X-Forwarded-For is ignored so a client cannot forge its own IP in
# the audit log and defeat login throttling.
APP_TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dfms
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# AI provider (Phase 5 — not yet wired into any user-facing feature)
# ---------------------------------------------------------------------------
# Leave blank to run with AI features in their degraded/offline state.
# aiComplete() checks this and returns ok=false rather than failing.
ANTHROPIC_API_KEY=
